# ============================================================
# TerraScan / EPICS Farm Scouting — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env or JSON service keys to git!
# ============================================================

# --- Google Earth Engine ---
# Your GEE Cloud project ID (console.cloud.google.com)
GEE_PROJECT_ID=your-gee-project-id

# Set to False for real Sentinel-1/2 data, True for simulated demo mode
DEMO_MODE=False

# Option A (Local): path to a service account JSON key (or leave blank for `earthengine authenticate`)
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Option B (Cloud / Render): paste the entire single-line Google Service Account JSON key here
GEE_SERVICE_ACCOUNT_JSON=

# --- Database ---
# Local SQLite default (or postgresql://... in production)
DATABASE_URL=sqlite:///./farm_scout.db

# --- CORS / Security ---
# Comma-separated production frontend URLs (e.g. https://your-app.vercel.app)
FRONTEND_URL=
SECRET_KEY=change-this-to-a-random-secret-key
