# ============================================================
# EPICS Farm Scouting — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# ============================================================

# --- Google Earth Engine ---
# Your GEE Cloud project ID (get one at console.cloud.google.com)
# Then run: earthengine authenticate
GEE_PROJECT_ID=your-gee-project-id

# Set to False to use real Sentinel-2 data, True for simulated demo data
DEMO_MODE=True

# Optional: path to a service account JSON key
# Leave blank to use personal OAuth credentials (earthengine authenticate)
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- Database ---
DATABASE_URL=sqlite:///./farm_scout.db

# --- App Security ---
SECRET_KEY=change-this-to-a-random-secret-key
